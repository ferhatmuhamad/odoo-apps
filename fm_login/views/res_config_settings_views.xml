<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fm.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Login Screen" string="Login Screen" name="fm_login"
                     logo="/fm_login/static/description/icon.png">

                    <block title="Login Screen" name="fm_login_style_block">
                        <setting string="Screen" help="Applies to everyone signing in to this database — the login page is rendered before anyone is identified, so it cannot follow a personal preference.">
                            <field name="fm_login_style" widget="radio"/>

                            <!-- Preview of whichever screen is selected. Captured
                                 from the running pages, so what is chosen here is
                                 what people will actually see. -->
                            <div class="mt-3">
                                <div invisible="fm_login_style != 'split'">
                                    <img src="/fm_login/static/description/images/preview_split.png"
                                         alt="Split — a brand panel beside the form"
                                         class="img-fluid border rounded"/>
                                    <div class="text-muted small mt-1">A brand panel beside the form. Your logo gets half the screen.</div>
                                </div>
                                <div invisible="fm_login_style != 'card'">
                                    <img src="/fm_login/static/description/images/preview_card.png"
                                         alt="Card — one card on a plain ground"
                                         class="img-fluid border rounded"/>
                                    <div class="text-muted small mt-1">One card on a plain ground. No panel, no imagery, no motion.</div>
                                </div>
                                <div invisible="fm_login_style != 'open'">
                                    <img src="/fm_login/static/description/images/preview_open.png"
                                         alt="Open — the form on a field of colour"
                                         class="img-fluid border rounded"/>
                                    <div class="text-muted small mt-1">The form on a field of colour, with underlines instead of boxes. Set the colour below.</div>
                                </div>
                                <div class="text-muted small" invisible="fm_login_style != 'odoo'">
                                    Odoo's own login page, unchanged.
                                </div>
                            </div>
                        </setting>

                        <setting string="Background colour"
                                 help="Six-digit hex, for example #1C1C22. Text and the accent are worked out from it, so a pale colour still reads."
                                 invisible="fm_login_style != 'open'">
                            <field name="fm_login_color" placeholder="#1C1C22"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
