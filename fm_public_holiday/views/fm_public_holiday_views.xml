<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fm_public_holiday_view_tree" model="ir.ui.view">
        <field name="name">fm.public.holiday.view.tree</field>
        <field name="model">fm.public.holiday</field>
        <field name="arch" type="xml">
            <tree string="Public Holidays">
                <field name="date"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="year" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="fm_public_holiday_view_form" model="ir.ui.view">
        <field name="name">fm.public.holiday.view.form</field>
        <field name="model">fm.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Holiday"/>
                        <h1><field name="name" placeholder="e.g. Independence Day"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="country_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="year"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fm_public_holiday_view_calendar" model="ir.ui.view">
        <field name="name">fm.public.holiday.view.calendar</field>
        <field name="model">fm.public.holiday</field>
        <field name="arch" type="xml">
            <calendar string="Public Holidays" date_start="date" mode="year" quick_create="0">
                <field name="name"/>
                <field name="country_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="fm_public_holiday_view_search" model="ir.ui.view">
        <field name="name">fm.public.holiday.view.search</field>
        <field name="model">fm.public.holiday</field>
        <field name="arch" type="xml">
            <search string="Search Public Holidays">
                <field name="name"/>
                <field name="country_id"/>
                <field name="year"/>
                <filter name="filter_this_year" string="This Year"
                        domain="[('year', '=', context_today().year)]"/>
                <filter name="filter_upcoming" string="Upcoming"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_by_country" string="Country" domain="[]"
                            context="{'group_by': 'country_id'}"/>
                    <filter name="group_by_year" string="Year" domain="[]"
                            context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fm_public_holiday_action" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">fm.public.holiday</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="search_view_id" ref="fm_public_holiday_view_search"/>
        <field name="context">{'search_default_group_by_country': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No public holiday in the reference list yet
            </p>
            <p>
                This list is the catalogue the importer reads from. It ships with
                16 countries covering 2025 to 2030.
            </p>
        </field>
    </record>

</odoo>
