<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="public_holiday_import_view_form" model="ir.ui.view">
        <field name="name">fm.public.holiday.import.view.form</field>
        <field name="model">fm.public.holiday.import</field>
        <field name="arch" type="xml">
            <form string="Import Public Holidays">
                <field name="state" invisible="1"/>
                <field name="library_available" invisible="1"/>
                <field name="country_count" invisible="1"/>
                <field name="available_count" invisible="1"/>
                <field name="missing_country_ids" invisible="1" widget="many2many_tags"/>

                <!-- ============ STEP 1 : scope ============ -->
                <div invisible="state != 'draft'">
                    <group>
                        <group string="Countries">
                            <field name="country_ids" widget="many2many_tags" nolabel="1"
                                   colspan="2" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Type a country name, or use the buttons below"/>
                            <div colspan="2" class="mt-1">
                                <button name="action_select_all" type="object"
                                        string="Select all available" class="btn btn-link ps-0"
                                        icon="fa-check-square-o"/>
                                <button name="action_clear_countries" type="object"
                                        string="Clear" class="btn btn-link"
                                        icon="fa-times" invisible="country_count == 0"/>
                            </div>
                        </group>
                        <group string="Period">
                            <field name="year_from" options="{'enable_formatting': False}"/>
                            <field name="year_to" options="{'enable_formatting': False}"/>
                        </group>
                    </group>

                    <group string="Apply to">
                        <field name="apply_mode" widget="radio" nolabel="1" colspan="2"/>
                        <field name="calendar_ids" widget="many2many_tags" nolabel="1"
                               colspan="2" options="{'no_create': True}"
                               invisible="apply_mode != 'schedules'"
                               placeholder="Leave empty for every working schedule of this company"/>
                        <div colspan="2" class="text-muted small"
                             invisible="apply_mode != 'global'">
                            One entry per holiday, shared by every working schedule —
                            including schedules you create later.
                        </div>
                    </group>

                    <div class="alert alert-info" role="status" invisible="available_count == 0">
                        <strong><field name="available_count" class="d-inline"/> holiday date(s)</strong>
                        <span> found. You will be able to uncheck the ones you do not want.</span>
                        <pre class="mt-2 mb-0" style="white-space:pre-wrap; font-size:0.9em;"><field name="preview" nolabel="1" readonly="1"/></pre>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not missing_names">
                        <p class="mb-1">
                            <strong>No data yet for:</strong>
                            <field name="missing_names" class="d-inline" readonly="1"/>
                        </p>
                        <p class="mb-0" invisible="not library_available">
                            Click <em>Fetch from library</em> to generate those dates.
                        </p>
                        <p class="mb-0" invisible="library_available">
                            To unlock more countries, ask your administrator to install the
                            Python package: <code>pip install holidays</code>
                        </p>
                    </div>
                </div>

                <!-- ============ STEP 2 : pick individual holidays ============ -->
                <div invisible="state != 'select'">
                    <div class="alert alert-info d-flex align-items-center justify-content-between" role="status">
                        <div>
                            <strong><field name="selected_count" class="d-inline"/></strong>
                            <span> of </span>
                            <field name="available_count" class="d-inline"/>
                            <span> holidays will be imported. Remove a line to leave it out.</span>
                        </div>
                        <div class="text-nowrap ms-3">
                            <button name="action_check_all_holidays" type="object"
                                    string="Check all" class="btn btn-link py-0"
                                    icon="fa-check-square-o"/>
                            <button name="action_uncheck_all_holidays" type="object"
                                    string="Uncheck all" class="btn btn-link py-0"
                                    icon="fa-square-o" invisible="selected_count == 0"/>
                        </div>
                    </div>

                    <field name="holiday_ids" nolabel="1" colspan="2">
                        <tree create="0" edit="0" delete="1" limit="200">
                            <field name="date"/>
                            <field name="name"/>
                            <field name="country_id"/>
                        </tree>
                    </field>

                    <div class="alert alert-warning mt-2" role="alert"
                         invisible="selected_count != 0">
                        Every holiday has been unchecked. Add some back with
                        <em>Check all</em>, or go back to change the countries.
                    </div>
                </div>

                <!-- ============ STEP 3 : result ============ -->
                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="status">
                        <h4 class="mt-0">Import finished</h4>
                        <group col="4" class="mb-0">
                            <field name="created_count" string="Created"/>
                            <field name="skipped_count" string="Already present"/>
                            <field name="calendar_count" string="Schedules updated"/>
                        </group>
                    </div>
                    <p class="text-muted">
                        The holidays are now in <strong>Time Off → Configuration → Public Holidays</strong>
                        and are excluded from working time on every schedule you selected.
                    </p>
                </div>

                <footer>
                    <!-- step 1 -->
                    <button name="action_load_holidays" type="object"
                            string="Next: choose holidays" class="btn-primary"
                            invisible="state != 'draft' or available_count == 0"
                            data-hotkey="q"/>
                    <button name="action_fetch_from_library" type="object"
                            string="Fetch from library" class="btn-secondary"
                            invisible="state != 'draft' or not library_available or not missing_names"/>
                    <!-- step 2 -->
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"
                            invisible="state != 'select' or selected_count == 0"
                            data-hotkey="q"/>
                    <button name="action_back" type="object" string="Back"
                            class="btn-secondary" invisible="state != 'select'"/>
                    <!-- step 3 -->
                    <button name="action_back" type="object" string="Import more"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="public_holiday_import_action" model="ir.actions.act_window">
        <field name="name">Import Public Holidays</field>
        <field name="res_model">fm.public.holiday.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
