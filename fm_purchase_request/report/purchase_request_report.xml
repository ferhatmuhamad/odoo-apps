<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">Purchase Request</field>
        <field name="model">fm.purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fm_purchase_request.report_purchase_request</field>
        <field name="report_file">fm_purchase_request.report_purchase_request</field>
        <field name="print_report_name">(object.name)</field>
        <field name="binding_model_id" ref="model_fm_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mb-1">
                            Purchase Request <span t-field="o.name"/>
                        </h2>
                        <p class="text-muted mb-3">
                            <span t-field="o.state"/>
                            <t t-if="o.priority == '1'"> &#183; Urgent</t>
                        </p>

                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Requested by</strong><br/>
                                <span t-field="o.requester_id.name"/>
                                <t t-if="o.department_id"><br/><span t-field="o.department_id.name"/></t>
                            </div>
                            <div class="col-3">
                                <strong>Request date</strong><br/>
                                <span t-field="o.date_request"/>
                            </div>
                            <div class="col-3">
                                <strong>Needed by</strong><br/>
                                <span t-field="o.date_needed"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <strong>What it is for</strong>
                            <p t-field="o.purpose" class="mb-0"/>
                        </div>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Est. unit price</th>
                                    <th class="text-end">Est. amount</th>
                                    <th>Vendor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l" t-att-class="'text-muted' if l.is_cancelled else ''">
                                    <td>
                                        <span t-field="l.name"/>
                                        <t t-if="l.product_id"><br/><small class="text-muted" t-field="l.product_id.display_name"/></t>
                                        <t t-if="l.is_cancelled"><br/><small>Dropped<t t-if="l.cancel_note">: <span t-field="l.cancel_note"/></t></small></t>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="l.product_qty"/> <span t-field="l.product_uom_id.name" groups="uom.group_uom"/>
                                    </td>
                                    <td class="text-end"><span t-field="l.price_estimated"/></td>
                                    <td class="text-end"><span t-field="l.amount_estimated"/></td>
                                    <td><span t-field="l.vendor_id.name"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Estimated total</strong></td>
                                    <td class="text-end"><strong><span t-field="o.amount_estimated"/></strong></td>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-4" t-if="o.state != 'draft'">
                            <div class="col-4">
                                <strong>Submitted</strong><br/>
                                <span t-field="o.requester_id.name"/><br/>
                                <small t-field="o.date_submitted"/>
                            </div>
                            <div class="col-4" t-if="o.approved_by_id">
                                <strong>Approved</strong><br/>
                                <span t-field="o.approved_by_id.name"/><br/>
                                <small t-field="o.date_approved"/>
                            </div>
                            <div class="col-4" t-if="o.validated_by_id">
                                <strong>Validated</strong><br/>
                                <span t-field="o.validated_by_id.name"/><br/>
                                <small t-field="o.date_validated"/>
                            </div>
                            <div class="col-4" t-if="o.rejected_by_id">
                                <strong>Rejected</strong><br/>
                                <span t-field="o.rejected_by_id.name"/><br/>
                                <small t-field="o.date_rejected"/>
                                <p class="mb-0" t-field="o.reject_reason"/>
                            </div>
                        </div>

                        <div class="mt-3" t-if="o.purchase_order_ids">
                            <strong>Purchase orders:</strong>
                            <t t-foreach="o.purchase_order_ids" t-as="po">
                                <span t-field="po.name"/><t t-if="not po_last">, </t>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
