<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Everyone sees what they asked for and what they must approve.
             Purchasing sees everything. No group of its own to configure:
             the Purchase app's groups already say who buys. -->
        <record id="rule_purchase_request_own" model="ir.rule">
            <field name="name">Purchase Request: own, or to approve</field>
            <field name="model_id" ref="model_fm_purchase_request"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('approver_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_purchase_request_purchase" model="ir.rule">
            <field name="name">Purchase Request: purchasing sees all</field>
            <field name="model_id" ref="model_fm_purchase_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>
        <record id="rule_purchase_request_company" model="ir.rule">
            <field name="name">Purchase Request: multi-company</field>
            <field name="model_id" ref="model_fm_purchase_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_purchase_request_line_own" model="ir.rule">
            <field name="name">Purchase Request Item: own, or to approve</field>
            <field name="model_id" ref="model_fm_purchase_request_line"/>
            <field name="domain_force">['|', ('request_id.user_id', '=', user.id), ('request_id.approver_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_purchase_request_line_purchase" model="ir.rule">
            <field name="name">Purchase Request Item: purchasing sees all</field>
            <field name="model_id" ref="model_fm_purchase_request_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>
        <record id="rule_purchase_request_line_company" model="ir.rule">
            <field name="name">Purchase Request Item: multi-company</field>
            <field name="model_id" ref="model_fm_purchase_request_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
