<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_fm_request" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.fm.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fm_requests" type="object" class="oe_stat_button"
                        icon="fa-hand-paper-o" invisible="fm_request_count == 0">
                    <field name="fm_request_count" widget="statinfo" string="Requests"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="fm_request_id" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_fm_request" model="ir.ui.view">
        <field name="name">purchase.order.search.inherit.fm.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fm_request_ids" string="Purchase Request"/>
            </xpath>
        </field>
    </record>

</odoo>
