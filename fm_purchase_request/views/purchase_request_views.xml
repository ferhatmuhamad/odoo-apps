<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════ Form ══════════════════════ -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">fm.purchase.request.form</field>
        <field name="model">fm.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary"
                            invisible="not can_validate"/>
                    <button name="action_make_purchase_order" string="Create Purchase Order" type="object" class="btn-primary"
                            invisible="not can_purchase or purchase_state in ('ordered', 'received')"/>
                    <button name="action_receive" string="Received" type="object" class="btn-primary"
                            invisible="state != 'ordered' or not (is_requester or can_purchase)"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="not (can_approve or can_validate or (can_purchase and state == 'approved'))"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('ordered', 'received', 'rejected', 'cancelled')"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,ordered,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="purchase_count == 0"
                                groups="purchase.group_purchase_user">
                            <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Received" bg_color="text-bg-success" invisible="state != 'received'"/>
                    <div class="oe_title">
                        <h1 class="d-flex align-items-center gap-2">
                            <field name="priority" widget="priority" readonly="state not in ('draft', 'submitted')"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" widget="many2one_avatar_employee"
                                   readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <!-- The requester must not pick their own approver. Purchase
                                 managers may correct it; everyone else only reads it. -->
                            <field name="manager_id" widget="many2one_avatar_employee" readonly="1"
                                   groups="!purchase.group_purchase_manager"/>
                            <field name="manager_id" widget="many2one_avatar_employee"
                                   readonly="state not in ('draft', 'submitted', 'to_validate')"
                                   groups="purchase.group_purchase_manager"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_request"/>
                            <field name="date_needed" readonly="state != 'draft'"/>
                            <field name="amount_estimated"/>
                            <field name="purchase_state" invisible="purchase_state == 'none'" widget="badge"
                                   decoration-info="purchase_state == 'partial'"
                                   decoration-success="purchase_state in ('ordered', 'received')"/>
                            <field name="purchase_order_names" invisible="not purchase_order_names"
                                   groups="!purchase.group_purchase_user"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="user_id" invisible="1"/>
                            <field name="approver_user_id" invisible="1"/>
                            <field name="can_approve" invisible="1"/>
                            <field name="can_validate" invisible="1"/>
                            <field name="can_purchase" invisible="1"/>
                            <field name="is_requester" invisible="1"/>
                        </group>
                    </group>
                    <group string="What is it for?">
                        <!-- colspan=2: a nolabel field in a group otherwise takes one
                             cell of the two-column grid, and a sentence wrapped into
                             a column ten characters wide reads like a poem. -->
                        <field name="purpose" nolabel="1" colspan="2" readonly="state != 'draft'"
                               placeholder="One or two sentences - this is what the approver reads first."/>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids" readonly="state != 'draft'" context="{'default_request_id': id}">
                                <list editable="bottom" decoration-muted="is_cancelled">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="e.g. HDMI cable, 2 m, for the meeting room"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="price_estimated"/>
                                    <field name="amount_estimated"/>
                                    <field name="url" widget="url" optional="show"/>
                                    <field name="vendor_id" optional="show"/>
                                    <field name="product_id" optional="hide" groups="purchase.group_purchase_user"/>
                                    <field name="qty_ordered" optional="show" column_invisible="parent.purchase_state == 'none'"/>
                                    <field name="qty_received" optional="show" column_invisible="parent.purchase_state == 'none'"/>
                                    <field name="purchase_state" widget="badge" optional="show"
                                           column_invisible="parent.purchase_state == 'none'"
                                           decoration-info="purchase_state == 'partial'"
                                           decoration-success="purchase_state in ('ordered', 'received')"/>
                                    <field name="is_cancelled" optional="hide"/>
                                    <field name="cancel_note" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval" name="approval" invisible="state == 'draft'">
                            <group>
                                <group string="Trail">
                                    <field name="date_submitted"/>
                                    <field name="approved_by_id" invisible="not approved_by_id"/>
                                    <field name="date_approved" invisible="not date_approved"/>
                                    <field name="validated_by_id" invisible="not validated_by_id"/>
                                    <field name="date_validated" invisible="not date_validated"/>
                                    <field name="rejected_by_id" invisible="not rejected_by_id"/>
                                    <field name="date_rejected" invisible="not date_rejected"/>
                                </group>
                                <group string="Why it was rejected" invisible="not reject_reason">
                                    <field name="reject_reason" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════ List ══════════════════════ -->
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">fm.purchase.request.tree</field>
        <field name="model">fm.purchase.request</field>
        <field name="arch" type="xml">
            <list string="Purchase Requests" decoration-muted="state in ('cancelled', 'rejected')"
                  decoration-info="state == 'submitted'" decoration-success="state == 'received'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="date_request"/>
                <field name="requester_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="show"/>
                <field name="purpose"/>
                <field name="date_needed" optional="show"/>
                <field name="amount_estimated" sum="Total"/>
                <field name="purchase_count" string="POs" optional="hide"/>
                <field name="purchase_state" optional="show" widget="badge"
                       decoration-info="purchase_state == 'partial'"
                       decoration-success="purchase_state in ('ordered', 'received')"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted', 'to_validate')"
                       decoration-warning="state == 'approved'"
                       decoration-success="state in ('ordered', 'received')"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════ Kanban ══════════════════════ -->
    <record id="view_purchase_request_kanban" model="ir.ui.view">
        <field name="name">fm.purchase.request.kanban</field>
        <field name="model">fm.purchase.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="requester_id"/>
                <field name="purpose"/>
                <field name="amount_estimated"/>
                <field name="currency_id"/>
                <field name="date_needed"/>
                <field name="purchase_count"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="card">
                        <div class="fm_pr_card">
                            <div class="d-flex align-items-start">
                                <field name="priority" widget="priority" class="me-1"/>
                                <strong class="o_kanban_record_title flex-grow-1"><field name="name"/></strong>
                                <span class="badge rounded-pill text-bg-light" t-if="record.purchase_count.raw_value">
                                    <i class="fa fa-shopping-cart me-1"/><t t-esc="record.purchase_count.raw_value"/>
                                </span>
                            </div>
                            <div class="text-muted small text-truncate fm_pr_card_purpose"><field name="purpose"/></div>
                            <footer class="d-flex pt-2 fm_pr_card_footer align-items-center">
                                <field name="requester_id" widget="many2one_avatar_employee" class="me-2"/>
                                <span class="me-auto"><field name="amount_estimated" widget="monetary"/></span>
                                <span t-if="record.date_needed.raw_value" class="text-muted small me-2">
                                    <i class="fa fa-calendar me-1"/><field name="date_needed"/>
                                </span>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════ Search ══════════════════════ -->
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">fm.purchase.request.search</field>
        <field name="model">fm.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name" string="Request"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('purpose', 'ilike', self), ('line_ids.name', 'ilike', self)]"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <filter name="my" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('approver_user_id', '=', uid), ('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="waiting" string="Waiting" domain="[('state', 'in', ('submitted', 'to_validate'))]"/>
                <filter name="approved" string="To Purchase" domain="[('state', '=', 'approved')]"/>
                <filter name="ordered" string="Ordered" domain="[('state', '=', 'ordered')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', '1')]"/>
                <filter name="late" string="Needed by is past" domain="[('date_needed', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ('received', 'rejected', 'cancelled'))]"/>
                <separator/>
                <filter name="activities_my" string="My Activities" domain="[('activity_user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════ Actions ══════════════════════ -->
    <record id="action_purchase_request_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">fm.purchase.request</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="view_purchase_request_search"/>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for something</p>
            <p>Write what you need in your own words, say what it is for, and submit.
               Your manager approves it, purchasing orders it, and you see every step here.</p>
        </field>
    </record>

    <record id="action_purchase_request_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">fm.purchase.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_purchase_request_search"/>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for you</p>
            <p>Requests from the people who report to you appear here when they are submitted.</p>
        </field>
    </record>

    <record id="action_purchase_request_all" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">fm.purchase.request</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="view_purchase_request_search"/>
        <field name="context">{'search_default_approved': 1, 'search_default_waiting': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No purchase requests yet</p>
            <p>Approved requests land here. Select them and use <i>Create Purchase Order</i>:
               one order per vendor, or added to the vendor's open RFQ.</p>
        </field>
    </record>

    <!-- Purchasing: many requests, one wizard. -->
    <record id="action_server_make_po" model="ir.actions.server">
        <field name="name">Create Purchase Order</field>
        <field name="model_id" ref="model_fm_purchase_request"/>
        <field name="binding_model_id" ref="model_fm_purchase_request"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_make_purchase_order()</field>
    </record>

</odoo>
