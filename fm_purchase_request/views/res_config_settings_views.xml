<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_fm_pr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fm.purchase.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Purchase Requests" name="fm_purchase_request_settings">
                    <setting string="Second validation"
                             help="After the manager's approval, requests above this estimated total also need a purchase manager's validation. Zero: never.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="fm_pr_validation_threshold" class="col-lg-4 o_light_label"/>
                                <field name="fm_pr_validation_threshold" class="col-lg-5"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
