<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_request_reject_form" model="ir.ui.view">
        <field name="name">fm.purchase.request.reject.form</field>
        <field name="model">fm.purchase.request.reject</field>
        <field name="arch" type="xml">
            <form string="Reject">
                <group>
                    <field name="request_id" readonly="1" force_save="1"/>
                    <field name="reason" placeholder="The requester reads this. Say what would make it approvable, if anything."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
