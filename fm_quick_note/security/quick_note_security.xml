<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_quick_note_user" model="res.groups">
            <field name="name">Quick Notes / User</field>
            <field name="category_id" ref="base.module_category_productivity"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_quick_note_manager" model="res.groups">
            <field name="name">Quick Notes / Administrator</field>
            <field name="category_id" ref="base.module_category_productivity"/>
            <field name="implied_ids" eval="[(4, ref('group_quick_note_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <record id="fm_quick_note_rule_own" model="ir.rule">
            <field name="name">Quick Note: own notes only</field>
            <field name="model_id" ref="model_fm_quick_note"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_quick_note_user'))]"/>
        </record>

        <record id="fm_quick_note_rule_all" model="ir.rule">
            <field name="name">Quick Note: all notes</field>
            <field name="model_id" ref="model_fm_quick_note"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_quick_note_manager'))]"/>
        </record>

    </data>
</odoo>
