<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_scoreboard" model="ir.module.category">
        <field name="name">Sales Scoreboard</field>
        <field name="sequence">60</field>
    </record>
    <!-- Who may look at the board. A screen on the wall usually logs in as
         a user of its own; give that user this group and nothing else. -->
    <record id="privilege_scoreboard" model="res.groups.privilege">
        <field name="name">Sales Scoreboard</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_scoreboard"/>
    </record>
    <record id="group_scoreboard" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_scoreboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_scoreboard'))]"/>
    </record>
</odoo>
